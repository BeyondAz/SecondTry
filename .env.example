# Copy to .env.local and replace placeholders with the authorized connection
# settings for Tiger Cloud service db-49307, database tsdb.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/tsdb

# Optional PEM CA certificate when Tiger requires a CA not trusted by the host.
# Use literal \n between certificate lines if placing it on one line.
DATABASE_CA_CERT=

# Optional server-side narration via ElevenLabs. Without a key, Listen is unavailable.
ELEVENLABS_API_KEY=
# Optional; otherwise the app uses its built-in default voice.
ELEVENLABS_VOICE_ID=

# Required for paid correction and narration endpoints in production.
# Use an Upstash Redis REST database; never expose these values in client code.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
